{
  "name": "dsh-web-kit",
  "version": "0.6.0",
  "description": "Standalone web_search / web_fetch capability extracted from DeepSeek Harness (deepseek-harness). Cordis-free, framework-neutral tool definitions, and search providers that need no third-party API key.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dsh-web-check": "scripts/check.mjs"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "ATTRIBUTION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:offline": "tsc -p tsconfig.json && node --test --test-concurrency=1 tests/filter.test.mjs tests/extract.test.mjs tests/markdown.test.mjs tests/index-options.test.mjs",
    "test:e2e": "tsc -p tsconfig.json && node --test --test-concurrency=1 tests/e2e-pipeline.test.mjs",
    "report": "tsc -p tsconfig.json && node scripts/extract-report.mjs",
    "check": "npm run build && node scripts/check.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "web-search",
    "web-fetch",
    "agent-tools",
    "searxng",
    "no-api-key"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "ipaddr.js": "^2.5.0",
    "playwright": "^1.64.0",
    "turndown": "^7.2.4",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.6",
    "playwright": "^1.64.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "playwright": "^1.64.0"
  }
}
